# Local development defaults. Copy to .env or let `task up` do it for you.
# Do NOT use these values in production.
AILERON_JWT_SIGNING_KEY=local-dev-signing-key-not-for-production
AILERON_AUTO_VERIFY_EMAIL=true

# OAuth sign-in providers (optional — enable by setting client ID and secret)
# GOOGLE_SIGNIN_CLIENT_ID=
# GOOGLE_SIGNIN_CLIENT_SECRET=
# GITHUB_SIGNIN_CLIENT_ID=
# GITHUB_SIGNIN_CLIENT_SECRET=

# OAuth connected account providers (optional — separate apps from sign-in)
# GOOGLE_CONNECTOR_CLIENT_ID=
# GOOGLE_CONNECTOR_CLIENT_SECRET=
# GITHUB_CONNECTOR_CLIENT_ID=
# GITHUB_CONNECTOR_CLIENT_SECRET=

# Zero-knowledge vault (optional — defaults shown)
# AILERON_KEK_SESSION_TTL=30m

# PostHog analytics (optional — set your project API key to enable)
# PUBLIC_POSTHOG_KEY=
# PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
