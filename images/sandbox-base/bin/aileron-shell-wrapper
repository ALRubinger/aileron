#!/bin/sh
# Aileron sandbox shell wrapper.
#
# Installed as /usr/local/bin/bash and /usr/local/bin/sh, ahead of the real
# shells on PATH, so `which bash` resolves here (R1) and `sh`-only callers are
# routed through Aileron. The wrapper itself decides nothing: it records which
# real shell it was invoked as and hands off to aileron-shell-mediator's `wrap`
# role, which sources the rcfile (mediation on) or execs the real shell
# untouched (mediation off, so non-mediated launches stay byte-for-byte
# identical, R7).
#
# The real shell is derived from the name the wrapper was invoked as, so the
# off-path passthrough keeps `sh` as `sh` and `bash` as `bash`.
case "${0##*/}" in
  sh) real_shell=/bin/sh ;;
  *)  real_shell=/bin/bash ;;
esac

AILERON_WRAP_SHELL="$real_shell" exec aileron-shell-mediator wrap "$@"
