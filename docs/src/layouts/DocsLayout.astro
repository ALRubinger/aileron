---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.svelte';
import MarkdownForAI from '../components/MarkdownForAI.svelte';
import Footer from '../components/Footer.svelte';

interface Props {
  title: string;
  headings?: { slug: string; text: string; depth: number }[];
  slug?: string;
  rawMarkdown?: string;
}

const { title, headings = [], slug = '', rawMarkdown = '' } = Astro.props;
---

<BaseLayout title={title}>
  <main class="px-6 pt-8 pb-8 lg:px-10 flex flex-col">
    <div class="flex gap-8">
      <div class="flex-1 min-w-0">
        <article class="prose">
          <h1>{title}</h1>
          <slot />
        </article>
      </div>

      <aside class="toc-aside">
        <div class="sticky top-20 max-h-[calc(100vh-5rem)] overflow-y-auto pr-4 -mr-4 pb-4">
          <div class="mb-3">
            <MarkdownForAI slug={slug} rawMarkdown={rawMarkdown} client:load />
          </div>
          <TableOfContents headings={headings} client:load />
        </div>
      </aside>
    </div>

    <Footer />
  </main>
</BaseLayout>
