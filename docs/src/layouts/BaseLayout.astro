---
import Sidebar from '../components/Sidebar.svelte';
import { navigation } from '../lib/navigation';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const currentPath = Astro.url.pathname;

const nav = navigation;
